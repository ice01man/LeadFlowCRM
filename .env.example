# ---- Servidor ----
NODE_ENV=production
PORT=3000
# Solo si el frontend vive en otro dominio (separados por coma). Vacío = mismo origen.
CORS_ORIGIN=

# ---- Base de datos ----
# MONGODB_URI: la cadena de conexión que te da Atlas (mongodb+srv://...). Nunca la subas al repo.
# mongo | memoria (memoria solo para desarrollo y tests; prohibida con NODE_ENV=production)
PERSISTENCIA=mongo
MONGODB_URI=
MONGODB_DB=leadflow

# ---- Sesión ----
# Mínimo 32 caracteres. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=8h

# ---- Solo desarrollo local (PERSISTENCIA=memoria) ----
# Email del superadmin local; la contraseña se genera al azar en cada arranque.
LOCAL_ADMIN_EMAIL=

# ---- IA / LLM (opcional; sin clave, la capa LLM queda apagada) ----
# anthropic | openai | gemini | zai | ollama
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3
LLM_CACHE_TTL_HOURS=24
